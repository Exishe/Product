# Copy to .env.local and fill in. Never commit .env.local.
# The app holds no Supabase secret key (ADR-038).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
APP_BASE_URL=http://localhost:3000

# Menu import. gemini while the free-only rule holds; claude later; fake for
# browser tests (returns a fixed menu).
AI_PROVIDER=gemini
GEMINI_API_KEY=
# Tried in order; each has 20 free requests a day (ADR-041).
GEMINI_MODELS=gemini-flash-latest,gemini-3-flash-preview,gemini-3.1-flash-lite
ANTHROPIC_API_KEY=

# Optional until the pilot
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://eu.i.posthog.com
NEXT_PUBLIC_SENTRY_DSN=
